# Supabase (Project Settings -> API Keys). Publishable key works because RLS is off.
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_KEY=sb_publishable_or_secret_key

# Durable actors local server
DURABLE_ACTORS_CONTROL_PLANE_URL=http://127.0.0.1:7100

# Narrator LLM: set OPENAI_API_KEY for cloud, otherwise local Ollama is used, otherwise a template.
# OPENAI_API_KEY=
# LLM_MODEL=gpt-5-mini
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gpt-oss:20b

# Share-by-QR + email alerts
# APP_URL=https://your-app.streamlit.app        (public URL the QR code points to)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password          (Google Account -> Security -> App passwords)
# ALERT_FROM=you@gmail.com
# ALERT_MIN_LEVEL=1                             (1 Advisory, 2 Watch, 3 Warning)
